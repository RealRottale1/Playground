{
  "manifest_version": 3,
  "name": "Easier Math Symbols",
  "version": "1.0",
  "description": "Converts input into math symbols.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "debugger"
  ]
}